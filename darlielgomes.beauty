<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Darliel Gomes — Luxury Hair at Home | London</title>
<style>
  :root {
    --bg: #0f0e0d;
    --surface: #1a1816;
    --gold: #c9a87c;
    --gold-light: #e8d5b5;
    --text: #f5f0e8;
    --muted: #9a9080;
    --accent: #b08d57;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Georgia', 'Times New Roman', serif;
    line-height: 1.7;
    overflow-x: hidden;
  }

  /* Grain */
  .grain {
    position: fixed; inset: 0; z-index: 9999; pointer-events: none;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* Navigation */
  nav {
    position: fixed; top: 0; width: 100%; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.1rem 2.5rem;
    background: rgba(15,14,13,0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(201,168,124,0.12);
    transition: padding 0.3s;
  }
  nav.scrolled { padding: 0.8rem 2.5rem; }
  .logo {
    font-size: 1.15rem; letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--gold); text-decoration: none; font-weight: 400;
  }
  .nav-links { display: flex; gap: 2.2rem; list-style: none; }
  .nav-links a {
    color: var(--muted); text-decoration: none; font-size: 0.78rem;
    letter-spacing: 0.18em; text-transform: uppercase; transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--gold); }
  .nav-cta {
    background: transparent; border: 1px solid var(--gold);
    color: var(--gold); padding: 0.55rem 1.4rem; font-size: 0.72rem;
    letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer;
    transition: all 0.35s; font-family: inherit;
  }
  .nav-cta:hover { background: var(--gold); color: var(--bg); }

  /* Mobile menu */
  .menu-toggle {
    display: none; background: none; border: none; color: var(--gold);
    font-size: 1.5rem; cursor: pointer;
  }

  /* Hero */
  header {
    min-height: 100vh; display: flex; flex-direction: column;
    justify-content: center; align-items: center; text-align: center;
    padding: 6rem 1.5rem 4rem; position: relative;
  }
  .hero-label {
    font-size: 0.78rem; letter-spacing: 0.45em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 1.2rem; opacity: 0;
    animation: fadeUp 1.2s 0.2s forwards;
  }
  .gold-line {
    width: 60px; height: 1px; background: var(--gold); margin: 0 auto 1.8rem;
    opacity: 0; animation: fadeUp 1.2s 0.4s forwards;
  }
  h1 {
    font-size: clamp(2.8rem, 7vw, 5.2rem); font-weight: 400;
    letter-spacing: 0.04em; line-height: 1.15; opacity: 0;
    animation: fadeUp 1.2s 0.5s forwards;
  }
  h1 span { color: var(--gold); font-style: italic; }
  .hero-sub {
    max-width: 520px; margin: 1.6rem auto 0; color: var(--muted);
    font-size: 1.05rem; opacity: 0; animation: fadeUp 1.2s 0.7s forwards;
  }
  .hero-cta {
    margin-top: 2.8rem; display: flex; gap: 1.2rem; flex-wrap: wrap; justify-content: center;
    opacity: 0; animation: fadeUp 1.2s 0.9s forwards;
  }
  .btn {
    padding: 0.95rem 2.3rem; font-family: inherit; font-size: 0.78rem;
    letter-spacing: 0.25em; text-transform: uppercase; cursor: pointer;
    transition: all 0.4s; border: 1px solid var(--gold);
  }
  .btn-primary { background: var(--gold); color: var(--bg); }
  .btn-primary:hover { background: var(--gold-light); border-color: var(--gold-light); }
  .btn-outline { background: transparent; color: var(--gold); }
  .btn-outline:hover { background: var(--gold); color: var(--bg); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Sections */
  section { padding: 5.5rem 2rem; max-width: 1100px; margin: 0 auto; }
  .section-label {
    font-size: 0.72rem; letter-spacing: 0.35em; text-transform: uppercase;
    color: var(--gold); text-align: center; margin-bottom: 0.6rem;
  }
  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 400;
    letter-spacing: 0.12em; text-transform: uppercase; text-align: center;
    margin-bottom: 1.2rem; color: var(--text);
  }
  .section-intro {
    text-align: center; color: var(--muted); max-width: 620px;
    margin: 0 auto 3.5rem; font-size: 1.02rem;
  }

  /* About */
  .about-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center;
  }
  .about-text p { color: var(--muted); margin-bottom: 1.3rem; }
  .about-text p:last-child { margin-bottom: 0; }
  .about-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.2rem;
  }
  .stat-box {
    background: var(--surface); border: 1px solid rgba(201,168,124,0.12);
    padding: 1.4rem 1.2rem; text-align: center;
  }
  .stat-num { font-size: 1.9rem; color: var(--gold); margin-bottom: 0.3rem; }
  .stat-label { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); }

  /* Services */
  .services-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.6rem;
  }
  .service-card {
    background: var(--surface); border: 1px solid rgba(201,168,124,0.1);
    padding: 2.2rem 1.8rem; transition: all 0.4s; position: relative; overflow: hidden;
  }
  .service-card::before {
    content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0; transition: opacity 0.4s;
  }
  .service-card:hover {
    border-color: rgba(201,168,124,0.35);
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }
  .service-card:hover::before { opacity: 1; }
  .service-num {
    font-size: 0.7rem; letter-spacing: 0.2em; color: var(--gold); margin-bottom: 0.8rem;
  }
  .service-card h3 {
    font-size: 1.25rem; font-weight: 400; margin-bottom: 0.9rem; letter-spacing: 0.05em;
  }
  .service-card p { color: var(--muted); font-size: 0.95rem; margin-bottom: 1.3rem; }
  .service-meta {
    font-size: 0.78rem; color: var(--gold); letter-spacing: 0.08em;
  }

  /* How it works */
  .process {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem;
    margin-top: 1rem;
  }
  .step {
    text-align: center; padding: 1.5rem 1rem;
  }
  .step-num {
    width: 48px; height: 48px; border: 1px solid var(--gold); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.2rem; color: var(--gold); font-size: 1.1rem;
  }
  .step h4 { font-weight: 400; margin-bottom: 0.6rem; letter-spacing: 0.06em; }
  .step p { color: var(--muted); font-size: 0.92rem; }

  /* Coverage */
  .coverage-box {
    background: var(--surface); border: 1px solid rgba(201,168,124,0.12);
    padding: 2.5rem; text-align: center; margin-top: 1rem;
  }
  .coverage-box p { color: var(--muted); max-width: 560px; margin: 0 auto 1.5rem; }
  .boroughs {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem;
  }
  .borough {
    background: rgba(201,168,124,0.08); border: 1px solid rgba(201,168,124,0.15);
    padding: 0.4rem 1rem; font-size: 0.78rem; letter-spacing: 0.08em; color: var(--gold-light);
  }

  /* Testimonials */
  .testimonials {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.6rem;
  }
  .testimonial {
    background: var(--surface); border: 1px solid rgba(201,168,124,0.1);
    padding: 2rem 1.8rem;
  }
  .stars { color: var(--gold); letter-spacing: 0.15em; margin-bottom: 1rem; font-size: 0.9rem; }
  .testimonial p { color: var(--muted); font-style: italic; margin-bottom: 1.3rem; }
  .client-name { font-size: 0.85rem; letter-spacing: 0.1em; color: var(--gold); }

  /* Instagram CTA */
  .ig-section {
    text-align: center; padding: 5rem 2rem;
    background: linear-gradient(180deg, transparent, rgba(201,168,124,0.04), transparent);
  }
  .ig-section a {
    display: inline-block; margin-top: 1.8rem; color: var(--gold);
    text-decoration: none; letter-spacing: 0.2em; font-size: 0.9rem;
    border-bottom: 1px solid transparent; transition: border 0.3s;
  }
  .ig-section a:hover { border-bottom-color: var(--gold); }

  /* Contact / Booking */
  .contact-grid {
    display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: start;
  }
  .contact-info h3 { font-weight: 400; margin-bottom: 1rem; letter-spacing: 0.08em; }
  .contact-info p { color: var(--muted); margin-bottom: 1.5rem; }
  .info-item { margin-bottom: 1.2rem; }
  .info-item span { display: block; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.3rem; }
  .info-item a { color: var(--text); text-decoration: none; transition: color 0.3s; }
  .info-item a:hover { color: var(--gold); }

  form {
    display: flex; flex-direction: column; gap: 1.2rem;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  input, select, textarea {
    background: var(--surface); border: 1px solid rgba(201,168,124,0.18);
    color: var(--text); padding: 1rem 1.1rem; font-family: inherit; font-size: 0.95rem;
    outline: none; transition: border 0.3s; width: 100%;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--gold); }
  select { cursor: pointer; appearance: none; }
  textarea { resize: vertical; min-height: 120px; }
  .form-note { font-size: 0.8rem; color: var(--muted); text-align: center; margin-top: 0.5rem; }
  #form-msg {
    text-align: center; color: var(--gold); min-height: 1.4rem;
    font-size: 0.9rem; letter-spacing: 0.08em; margin-top: 0.8rem;
  }

  /* Footer */
  footer {
    border-top: 1px solid rgba(201,168,124,0.12);
    padding: 2.8rem 2rem; text-align: center;
    color: var(--muted); font-size: 0.78rem; letter-spacing: 0.15em;
  }
  footer a { color: var(--gold); text-decoration: none; }

  /* Reveal animation */
  .reveal {
    opacity: 0; transform: translateY(28px);
    transition: all 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* Mobile */
  @media (max-width: 900px) {
    .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    nav { padding: 1rem 1.4rem; }
    .nav-links, .nav-cta { display: none; }
    .menu-toggle { display: block; }
    .nav-links.open {
      display: flex; flex-direction: column; position: absolute;
      top: 100%; left: 0; right: 0; background: var(--bg);
      padding: 1.5rem; gap: 1.2rem; border-bottom: 1px solid rgba(201,168,124,0.15);
    }
    section { padding: 4rem 1.4rem; }
    .hero-cta { flex-direction: column; align-items: center; }
  }
</style>
</head>
<body>
<div class="grain"></div>

<nav id="navbar">
  <a href="#" class="logo">Darliel Gomes</a>
  <ul class="nav-links" id="navLinks">
    <li><a href="#about">About</a></li>
    <li><a href="#services">Services</a></li>
    <li><a href="#process">Process</a></li>
    <li><a href="#reviews">Reviews</a></li>
    <li><a href="#contact">Book</a></li>
  </ul>
  <button class="nav-cta" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">Book Now</button>
  <button class="menu-toggle" id="menuToggle" aria-label="Menu">☰</button>
</nav>

<header>
  <p class="hero-label">London • Home Hair Services</p>
  <div class="gold-line"></div>
  <h1>Hair Artistry<br><span>Brought to You</span></h1>
  <p class="hero-sub">
    Bespoke cuts, colour and treatments delivered to your door across the whole of London. 
    Luxury salon results in the comfort of your home.
  </p>
  <div class="hero-cta">
    <button class="btn btn-primary" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">Book a Session</button>
    <a href="https://www.instagram.com/darlielgomes.beauty/" target="_blank" rel="noopener" class="btn btn-outline">View Instagram</a>
  </div>
</header>

<!-- ABOUT -->
<section id="about">
  <p class="section-label reveal">The Stylist</p>
  <h2 class="section-title reveal">About Darliel</h2>
  <div class="about-grid">
    <div class="about-text reveal">
      <p>
        I’m Darliel Gomes — a London-based hairstylist specialising in precision cutting, 
        lived-in colour, and restorative treatments. My work is rooted in understanding 
        each client’s lifestyle, hair texture and personal style so the result feels 
        effortless and truly yours.
      </p>
      <p>
        After years in high-end salons I chose to take my craft on the road. 
        Home services allow me to give every client undivided attention, a calm 
        environment, and the convenience of not having to travel or wait.
      </p>
      <p>
        Whether you need a sharp cut, a soft balayage, a deep treatment or bridal 
        styling, I arrive fully equipped and ready to create something beautiful 
        in your space.
      </p>
    </div>
    <div class="reveal">
      <div class="about-stats">
        <div class="stat-box">
          <div class="stat-num" data-target="8">0</div>
          <div class="stat-label">Years Experience</div>
        </div>
        <div class="stat-box">
          <div class="stat-num" data-target="600">0</div>
          <div class="stat-label">Happy Clients</div>
        </div>
        <div class="stat-box">
          <div class="stat-num" data-target="100">0</div>
          <div class="stat-label">% Home Service</div>
        </div>
        <div class="stat-box">
          <div class="stat-num" data-target="33">0</div>
          <div class="stat-label">London Boroughs</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services">
  <p class="section-label reveal">What I Offer</p>
  <h2 class="section-title reveal">Services</h2>
  <p class="section-intro reveal">
    Every appointment is tailored. Below is a guide to the main services I bring to your home.
  </p>
  <div class="services-grid">
    <div class="service-card reveal">
      <div class="service-num">01</div>
      <h3>Precision Cut & Style</h3>
      <p>Consultation, precise cutting and finishing blow-dry. Designed around your face shape, lifestyle and hair type for a look that grows out beautifully.</p>
      <div class="service-meta">From £65 • 60–90 min</div>
    </div>
    <div class="service-card reveal">
      <div class="service-num">02</div>
      <h3>Colour & Balayage</h3>
      <p>Full colour, highlights, lowlights or lived-in balayage. Soft, dimensional results that look natural and require minimal upkeep.</p>
      <div class="service-meta">From £120 • 2–3.5 hrs</div>
    </div>
    <div class="service-card reveal">
      <div class="service-num">03</div>
      <h3>Treatments & Repair</h3>
      <p>Deep conditioning, bond-building and restorative treatments for damaged, dry or chemically treated hair. Visible softness and strength.</p>
      <div class="service-meta">From £45 • 45–75 min</div>
    </div>
    <div class="service-card reveal">
      <div class="service-num">04</div>
      <h3>Bridal & Events</h3>
      <p>Trial and wedding-day styling, formal updos, soft waves and complete bridal parties. Calm, on-time service at your location.</p>
      <div class="service-meta">Quote on request</div>
    </div>
    <div class="service-card reveal">
      <div class="service-num">05</div>
      <h3>Blow-Dry & Styling</h3>
      <p>Perfect finish for events, photos or simply feeling polished. Volume, sleekness or soft movement — whatever the occasion needs.</p>
      <div class="service-meta">From £40 • 45–60 min</div>
    </div>
    <div class="service-card reveal">
      <div class="service-num">06</div>
      <h3>Children & Family</h3>
      <p>Gentle, patient cuts for children and family sessions. Comfortable environment at home means less stress for everyone.</p>
      <div class="service-meta">From £30 • 30–45 min</div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section id="process">
  <p class="section-label reveal">Simple & Seamless</p>
  <h2 class="section-title reveal">How Home Service Works</h2>
  <div class="process">
    <div class="step reveal">
      <div class="step-num">1</div>
      <h4>Book</h4>
      <p>Send a message or fill in the form with your preferred date, service and location.</p>
    </div>
    <div class="step reveal">
      <div class="step-num">2</div>
      <h4>Confirm</h4>
      <p>I’ll reply quickly to confirm availability, exact timing and any preparation notes.</p>
    </div>
    <div class="step reveal">
      <div class="step-num">3</div>
      <h4>I Arrive</h4>
      <p>Fully equipped with professional tools, products and a clean, organised set-up.</p>
    </div>
    <div class="step reveal">
      <div class="step-num">4</div>
      <h4>Relax</h4>
      <p>You stay comfortable at home while I take care of everything. No travel, no waiting room.</p>
    </div>
  </div>

  <div class="coverage-box reveal" style="margin-top: 3.5rem;">
    <h3 style="font-weight:400; margin-bottom:1rem; letter-spacing:0.08em;">Covering All of London</h3>
    <p>I travel to every borough. From Zone 1 to the outer edges of the city — if you’re in London, I can come to you.</p>
    <div class="boroughs">
      <span class="borough">Central London</span>
      <span class="borough">North London</span>
      <span class="borough">South London</span>
      <span class="borough">East London</span>
      <span class="borough">West London</span>
      <span class="borough">Greater London</span>
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section id="reviews">
  <p class="section-label reveal">Kind Words</p>
  <h2 class="section-title reveal">Client Love</h2>
  <div class="testimonials">
    <div class="testimonial reveal">
      <div class="stars">★★★★★</div>
      <p>“Darliel came to my flat in Shoreditch and gave me the best balayage I’ve ever had. So calm, professional and the result lasted for months.”</p>
      <div class="client-name">— Sophie, E2</div>
    </div>
    <div class="testimonial reveal">
      <div class="stars">★★★★★</div>
      <p>“I booked him for my wedding morning. He styled me and three bridesmaids at the house. Everything ran perfectly and the hair looked incredible all day.”</p>
      <div class="client-name">— Amara, SW6</div>
    </div>
    <div class="testimonial reveal">
      <div class="stars">★★★★★</div>
      <p>“Having a haircut at home with a toddler is a game-changer. Patient, quick and my hair has never looked better. Already booked the next one.”</p>
      <div class="client-name">— Lucy, N16</div>
    </div>
  </div>
</section>

<!-- INSTAGRAM -->
<div class="ig-section">
  <p class="section-label reveal">Follow the Work</p>
  <h2 class="section-title reveal">@darlielgomes.beauty</h2>
  <p class="section-intro reveal" style="margin-bottom:0;">
    Real clients, real results, daily inspiration.
  </p>
  <a href="https://www.instagram.com/darlielgomes.beauty/" target="_blank" rel="noopener" class="reveal">
    View Instagram →
  </a>
</div>

<!-- CONTACT / BOOKING -->
<section id="contact">
  <p class="section-label reveal">Get in Touch</p>
  <h2 class="section-title reveal">Book Your Appointment</h2>
  <div class="contact-grid">
    <div class="contact-info reveal">
      <h3>Let’s create something beautiful</h3>
      <p>Tell me a little about what you need and your preferred times. I’ll get back to you within a few hours to confirm.</p>
      
      <div class="info-item">
        <span>Instagram</span>
        <a href="https://www.instagram.com/darlielgomes.beauty/" target="_blank" rel="noopener">@darlielgomes.beauty</a>
      </div>
      <div class="info-item">
        <span>Service Area</span>
        All London boroughs
      </div>
      <div class="info-item">
        <span>Response Time</span>
        Usually within 2–4 hours
      </div>
    </div>

    <form class="reveal" onsubmit="handleSubmit(event)">
      <div class="form-row">
        <input type="text" name="name" placeholder="Your Name" required>
        <input type="email" name="email" placeholder="Email Address" required>
      </div>
      <div class="form-row">
        <input type="tel" name="phone" placeholder="Phone Number">
        <input type="text" name="area" placeholder="Your Area / Postcode" required>
      </div>
      <select name="service" required>
        <option value="" disabled selected>Select a Service</option>
        <option>Precision Cut & Style</option>
        <option>Colour / Balayage</option>
        <option>Treatment</option>
        <option>Bridal / Event</option>
        <option>Blow-Dry</option>
        <option>Children / Family</option>
        <option>Other / Not sure yet</option>
      </select>
      <input type="text" name="date" placeholder="Preferred Date or Timeframe">
      <textarea name="message" placeholder="Anything else I should know? (hair goals, previous colour, etc.)" rows="4"></textarea>
      <button type="submit" class="btn btn-primary" style="width:100%;">Send Booking Request</button>
      <p class="form-note">This form sends a message request. I’ll confirm availability personally.</p>
      <p id="form-msg"></p>
    </form>
  </div>
</section>

<footer>
  © 2026 Darliel Gomes · London Home Hair Services · 
  <a href="https://www.instagram.com/darlielgomes.beauty/" target="_blank" rel="noopener">Instagram</a>
</footer>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
  });

  // Mobile menu
  const menuToggle = document.getElementById('menuToggle');
  const navLinks = document.getElementById('navLinks');
  menuToggle.addEventListener('click', () => {
    navLinks.classList.toggle('open');
  });
  navLinks.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => navLinks.classList.remove('open'));
  });

  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Animated counters
  const counters = document.querySelectorAll('.stat-num');
  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target;
        const target = +el.dataset.target;
        let current = 0;
        const step = Math.max(1, Math.ceil(target / 50));
        const tick = () => {
          current += step;
          if (current >= target) {
            el.textContent = target + (target === 100 ? '%' : '+');
          } else {
            el.textContent = current;
            requestAnimationFrame(tick);
          }
        };
        tick();
        countObserver.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  counters.forEach(c => countObserver.observe(c));

  // Form handler
  function handleSubmit(e) {
    e.preventDefault();
    const msg = document.getElementById('form-msg');
    msg.textContent = "Thank you! I’ll be in touch shortly to confirm your appointment.";
    e.target.reset();
    setTimeout(() => { msg.textContent = ''; }, 5000);
  }
</script>
</body>
</html>